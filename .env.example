# Orange API Environment Configuration
AI_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Temporary default model for Phase 6A (four-model foundation):
DEFAULT_NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_CODER_MODEL=qwen/qwen2.5-coder-32b-instruct
NVIDIA_REASONING_MODEL=meta/llama-3.3-70b-instruct

# Hugging Face Inference Providers configuration (https://router.huggingface.co/v1):
HF_TOKEN=your_huggingface_token_here
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_INFERENCE_TIMEOUT=85.0
DEFAULT_HUGGINGFACE_MODEL=Qwen/Qwen3.8-27B:fastest

# SambaNova Cloud configuration (https://api.sambanova.ai/v1):
SAMBANOVA_API_KEY=your_sambanova_api_key_here
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_INFERENCE_TIMEOUT=85.0
DEFAULT_SAMBANOVA_MODEL=gpt-oss-120b
SAMBANOVA_REASONING_MODEL=Meta-Llama-3.3-70B-Instruct

# Shared secret for POST /assist bearer authentication (leave blank for local dev/testing without auth):
ORANGE_API_KEY=your_orange_api_key_here
